# Copier vers .env avant `npm run prod:up`
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-min-32-characters-long!!
CORS_ORIGIN=*

# Redis (compose prod injecte déjà REDIS_URL ; utile hors Docker)
# REDIS_URL=redis://localhost:6379

# File jobs → worker (1 = SMS async via Redis)
USE_JOB_QUEUE=1

# NeoScore ML (solvabilité)
# SCORING_ML_URL=http://neoscore-ml:8000
# SCORING_ML_TIMEOUT_MS=2500
# ADMIN_API_KEY=

# SMS — Twilio (recommandé)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+1xxxxxxxxxx

# SMS — gateway HTTP générique (alternative)
# SMS_GATEWAY_URL=
# SMS_API_KEY=

# Admin agents (X-Admin-Key)
# ADMIN_API_KEY=

# Mobile Money
# ORANGE_MM_URL=
# ORANGE_MM_API_KEY=
# MOOV_MM_URL=
# MOOV_MM_API_KEY=

# White-label
# BRAND_APP_NAME=NeoForma
# BRAND_PRIMARY_COLOR=#2DB88A
# PARTNER_BRAND_JSON=

# Ingestion KoboCollect (optionnel)
# KOBO_API_KEY=

# Partenaires IMF (décisions + commissions)
# PARTNER_API_KEY=

# Suivi d'erreurs / alertes (optionnel)
# SENTRY_DSN=
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
