DATABASE_URL="postgresql://neoforma:neoforma@localhost:5433/neoforma?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="neoforma-dev-secret-change-me-min-32-chars!!"
PORT=3001
HOST=0.0.0.0
# * = téléphone sur le LAN (PWA). En prod, fixer l'origine.
CORS_ORIGIN="*"
NODE_ENV="development"
# SMS — sans config : console + code affiché dans l'app (mode test)
#
# Option A — Twilio (recommandé)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_FROM="+221XXXXXXXXX"   # numéro Twilio (ou Messaging Service SID: MGxxx)
#
# Option B — gateway HTTP générique
# SMS_GATEWAY_URL="https://sms-provider.example/send"
# SMS_API_KEY="..."

# Ingestion KoboCollect (agents terrain / webhook KoboToolbox)
# KOBO_API_KEY="clé-partagée-longue-et-secrète"

# Suivi d'erreurs (optionnel)
# SENTRY_DSN=""
