# Image API seule — Render ne supporte pas dockerTarget sur un Dockerfile multi-stage.
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/shared/package.json packages/shared/
COPY packages/neoscore/package.json packages/neoscore/
RUN npm install

FROM deps AS api
WORKDIR /app
# Cache-bust 2026-09-02 : quantités décimales (kg/g/l)
COPY packages ./packages
COPY apps/api ./apps/api
# Relier le workspace après COPY, sinon node_modules peut garder un @neoforma/shared périmé.
WORKDIR /app
RUN npm install --prefer-offline --no-audit --no-fund
WORKDIR /app/apps/api
RUN npx prisma generate
RUN sed -i 's/\r$//' docker-entrypoint.sh && chmod +x docker-entrypoint.sh
ENV NODE_ENV=production
EXPOSE 3001
CMD ["./docker-entrypoint.sh"]
