generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Travailleur {
  id                    String    @id @default(uuid())
  telephone             String    @unique
  pinHash               String
  nomAffiche            String    @default("")
  genre                 String?
  statutCompte          String    @default("brouillon")
  onboardingTermine     Boolean   @default(false)
  dateDerniereConnexion DateTime?
  /// Verrouillage temporaire PIN (OWASP / UML MFA)
  pinFailCount          Int       @default(0)
  pinLockedUntil        DateTime?
  /// KYC léger — non_verifie | en_cours | verifie | refuse
  kycStatut             String    @default("non_verifie")
  pieceIdentiteType     String?
  pieceIdentiteNumero   String?
  dateNaissance         DateTime?
  adresse               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  profilActivite       ProfilActivite?
  preferences          Preferences?
  consentements        Consentement[]
  clientsInformels     ClientInformel[]
  operations           Operation[]
  operationsHorsLigne  OperationHorsLigne[]
  neoscore             NeoScore?
  offresCredit         OffreCredit[]
  demandesCredit       DemandeCredit[]
  accesProfilsImf      AccesProfilImf[]
  defisOtp             DefiOtp[]
  sessions             Session[]
  articlesStock        ArticleStock[]
  tontines             Tontine[]
  notifications        NotificationInApp[]
  pushTokens           DevicePushToken[]
  agentDossiers        AgentDossier[]

  @@map("travailleurs")
}

/// Jetons FCM (Android) / APNs via FCM (iOS) pour push distant.
model DevicePushToken {
  id            String   @id @default(uuid())
  travailleurId String
  token         String
  platform      String   @default("android")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  @@unique([travailleurId, token])
  @@index([travailleurId])
  @@map("device_push_tokens")
}

model ProfilActivite {
  id                   String   @id @default(uuid())
  travailleurId        String   @unique
  metier               String?
  ancienneteActivite   String?
  caJournalierEstime   String?
  participationTontine Boolean?
  cotisationTontine    Int?
  usageMobileMoney     String?
  statutCompteBancaire String?
  ville                String?
  zone                 String?
  chargesFixesMensuelles Int?
  /// stable | moderee | forte
  saisonnalite         String?  @default("stable")
  garantieSolidaire    Boolean? @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  @@map("profils_activite")
}

model Preferences {
  id                     String   @id @default(uuid())
  travailleurId          String   @unique
  langue                 String   @default("fr")
  modeIconographique     Boolean  @default(false)
  assistanceVocaleActive Boolean  @default(false)
  theme                  String   @default("system")
  fuseau                 String   @default("Africa/Ouagadougou")
  updatedAt              DateTime @updatedAt

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Consentement {
  id               String   @id @default(uuid())
  travailleurId    String
  type             String
  accorde          Boolean  @default(false)
  dateDecision     DateTime @default(now())
  versionPolitique String
  retractable      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  travailleur    Travailleur     @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  accesProfilsImf AccesProfilImf[]

  @@unique([travailleurId, type])
  @@index([type, accorde])
  @@map("consentements")
}

model ClientInformel {
  id            String   @id @default(uuid())
  travailleurId String
  nom           String
  telephone     String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  operations  Operation[]

  @@index([travailleurId])
  @@index([travailleurId, nom])
  @@map("clients_informels")
}

model Operation {
  id                     String    @id @default(uuid())
  travailleurId          String
  type                   String
  montantFcfa            Int
  /// Montant déjà encaissé (créance partielle).
  montantRegleFcfa       Int       @default(0)
  libelle                String?
  dateOperation          DateTime  @default(now())
  statutSync             String    @default("synchronisee")
  identifiantIdempotence String?   @unique
  clientId               String?
  natureStock            String?
  articleStockId         String?
  quantiteStock          Decimal?  @db.Decimal(12, 3)
  categorieDepense       String?
  /// especes | mobile_money
  canal                  String?
  echeance               DateTime?
  dateReglement          DateTime?
  statutCreance          String?
  derniereRelanceAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  travailleur         Travailleur          @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  client              ClientInformel?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  articleStock        ArticleStock?        @relation(fields: [articleStockId], references: [id], onDelete: SetNull)
  operationsHorsLigne OperationHorsLigne[]

  @@index([travailleurId, dateOperation])
  @@index([travailleurId, type])
  @@index([clientId])
  @@map("operations")
}

/// File offline — module sync
model OperationHorsLigne {
  id                String   @id @default(uuid())
  travailleurId     String
  identifiantLocal  String   @unique
  payload           String
  dateSaisieLocale  DateTime
  /// en_attente | acceptee | rejetee
  etat              String   @default("en_attente")
  motifRejet        String?
  operationId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  operation   Operation?  @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([travailleurId, etat])
  @@map("operations_hors_ligne")
}

/// Score courant — module scoring
model NeoScore {
  id                      String   @id @default(uuid())
  travailleurId           String   @unique
  valeur                  Int
  seuilEligibilite        Int      @default(50)
  eligible                Boolean
  segment                 String
  critereRegularite       Int
  critereVolume           Int
  critereGestionCreances  Int
  critereCroissance       Int
  periodeAnalyseJours     Int      @default(30)
  /// heuristic | ml
  moteur                  String   @default("heuristic")
  /// Version artefact ML (ex. 20260726-1430) si moteur=ml
  modelVersion            String?
  dateCalcul              DateTime @default(now())
  updatedAt               DateTime @updatedAt

  travailleur Travailleur          @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  historique  NeoScoreHistorique[]
  offres      OffreCredit[]

  @@map("neoscores")
}

model NeoScoreHistorique {
  id           String   @id @default(uuid())
  neoscoreId   String
  periode      String
  valeur       Int
  enregistreAt DateTime @default(now())

  neoscore NeoScore @relation(fields: [neoscoreId], references: [id], onDelete: Cascade)

  @@index([neoscoreId, enregistreAt])
  @@map("neoscore_historique")
}

model OffreCredit {
  id                    String    @id @default(uuid())
  travailleurId         String
  neoscoreId            String
  montantMinFcfa        Int
  montantMaxFcfa        Int
  montantSuggereFcfa    Int
  dureeMois             Int
  tauxMensuelIndicatif  Float
  eligible              Boolean
  dateGeneration        DateTime  @default(now())
  valideJusqua          DateTime?
  createdAt             DateTime  @default(now())

  travailleur Travailleur    @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  neoscore    NeoScore       @relation(fields: [neoscoreId], references: [id], onDelete: Restrict)
  demandes    DemandeCredit[]

  @@index([travailleurId, dateGeneration])
  @@map("offres_credit")
}

model SnapshotScore {
  id                     String   @id @default(uuid())
  valeur                 Int
  segment                String
  seuilEligibilite       Int
  critereRegularite      Int
  critereVolume          Int
  critereGestionCreances Int
  critereCroissance      Int
  dateFigee              DateTime @default(now())

  demandes DemandeCredit[]

  @@map("snapshots_score")
}

model Imf {
  id                String   @id @default(uuid())
  raisonSociale     String   @unique
  pays              String   @default("Burkina Faso")
  statutPartenariat String   @default("prospect")
  niveauAcces       String   @default("consultation")
  contactEmail      String?
  contactNom        String?
  /// Legacy clair (migré vers apiKeyHash) — ne plus écrire.
  apiKey            String?  @unique
  /// SHA-256 hex de la clé partenaire (lookup O(1)).
  apiKeyHash        String?  @unique
  /// Taux de commission NeoForma (ex. 0.02 = 2 %).
  tauxCommission    Float    @default(0.02)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  demandes        DemandeCredit[]
  accesProfilsImf AccesProfilImf[]
  commissions     Commission[]

  @@index([statutPartenariat])
  @@map("imf")
}

model DemandeCredit {
  id                     String    @id @default(uuid())
  reference              String    @unique
  travailleurId          String
  offreId                String?
  snapshotScoreId        String?
  imfId                  String?
  montantDemandeFcfa     Int
  usage                  String
  modaliteRemboursement  String
  /// brouillon | soumise | en_examen | approuvee | refusee | decaissee | cloturee
  statut                 String    @default("brouillon")
  dateSoumission         DateTime?
  motifDecision          String?
  /// Features NeoScore figées à la soumission (entraînement ML).
  featuresSnapshot       Json?
  dateDecaissement       DateTime?
  dateEcheance           DateTime?
  dateCloture            DateTime?
  /// null | en_cours | rembourse_ok | defaut — label solvabilité
  outcome                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  travailleur   Travailleur    @relation(fields: [travailleurId], references: [id], onDelete: Restrict)
  offre         OffreCredit?   @relation(fields: [offreId], references: [id], onDelete: Restrict)
  snapshotScore SnapshotScore? @relation(fields: [snapshotScoreId], references: [id], onDelete: Restrict)
  imf           Imf?           @relation(fields: [imfId], references: [id], onDelete: SetNull)
  commission    Commission?
  accesProfils  AccesProfilImf[]

  @@index([travailleurId, createdAt])
  @@index([statut])
  @@index([outcome])
  @@map("demandes_credit")
}

/// Historique des entraînements ML (monitoring).
model MlModelRun {
  id           String   @id @default(uuid())
  version      String   @unique
  trainedAt    DateTime @default(now())
  nSamples     Int
  nDefaults    Int
  auc          Float?
  source       String   @default("mixed")
  notes        String?
  /// Calibration DigiCoop / métadonnées modèle (JSON).
  payloadJson  Json?
  active       Boolean  @default(false)

  @@index([trainedAt])
  @@map("ml_model_runs")
}

model AccesProfilImf {
  id              String   @id @default(uuid())
  imfId           String
  travailleurId   String
  consentementId  String
  demandeCreditId String?
  dateAcces       DateTime @default(now())
  finalite        String
  anonymise       Boolean  @default(true)
  scorePresente   Int

  imf           Imf            @relation(fields: [imfId], references: [id], onDelete: Restrict)
  travailleur   Travailleur    @relation(fields: [travailleurId], references: [id], onDelete: Restrict)
  consentement  Consentement   @relation(fields: [consentementId], references: [id], onDelete: Restrict)
  demandeCredit DemandeCredit? @relation(fields: [demandeCreditId], references: [id], onDelete: SetNull)

  @@index([imfId, dateAcces])
  @@index([travailleurId, dateAcces])
  @@map("acces_profils_imf")
}

model Commission {
  id                    String   @id @default(uuid())
  demandeCreditId       String   @unique
  imfId                 String
  montantCreditFcfa     Int
  tauxCommission        Float
  montantCommissionFcfa Int
  /// due | facturee | payee
  statut                String   @default("due")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  demande DemandeCredit @relation(fields: [demandeCreditId], references: [id], onDelete: Restrict)
  imf     Imf           @relation(fields: [imfId], references: [id], onDelete: Restrict)

  @@index([imfId, statut])
  @@map("commissions")
}

model DefiOtp {
  id            String   @id @default(uuid())
  telephone     String
  codeHash      String
  /// register | login | reset
  purpose       String   @default("login")
  expireA       DateTime
  consomme      Boolean  @default(false)
  tentatives    Int      @default(0)
  travailleurId String?
  createdAt     DateTime @default(now())

  travailleur Travailleur? @relation(fields: [travailleurId], references: [id], onDelete: SetNull)

  @@index([telephone, createdAt])
  @@index([telephone, purpose, consomme])
  @@map("defis_otp")
}

model Session {
  id               String    @id @default(uuid())
  travailleurId    String
  /// Hash SHA-256 du refresh token opaque (jamais stocké en clair)
  refreshTokenHash String    @unique
  /// Hash SHA-256 de l'access JWT (révocation logout)
  accessTokenHash  String?   @unique
  /// Famille de rotation — réutilisation d'un ancien refresh ⇒ révocation famille
  familyId         String
  statut           String    @default("active")
  creeeA           DateTime  @default(now())
  expireA          DateTime
  revoqueeA        DateTime?
  userAgent        String?
  ip               String?

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  @@index([travailleurId, statut])
  @@index([familyId])
  @@map("sessions")
}

/// Collecte terrain KoboCollect — alimente les profils / NeoScore (pilote).
model KoboSubmission {
  id                  String   @id @default(uuid())
  /// _uuid KoboToolbox — idempotence des imports
  submissionId        String   @unique
  telephone           String?
  metier              String?
  ancienneteActivite  String?
  caJournalierEstime  String?
  participationTontine Boolean?
  cotisationTontine   Int?
  usageMobileMoney    String?
  statutCompteBancaire String?
  impayes             Int?
  nbTransactions      Int?
  interet             Int?
  langue              String?
  consentement        String?
  /// Payload brut Kobo (audit / retraitement)
  raw                 Json
  /// Travailleur rattaché si le téléphone correspond à un compte
  matchedTravailleurId String?
  importedAt          DateTime @default(now())

  @@index([telephone])
  @@index([matchedTravailleurId])
  @@map("kobo_submissions")
}

/// Catalogue stock local (unités en magasin).
model ArticleStock {
  id            String   @id @default(uuid())
  travailleurId String
  nom           String
  unite         String   @default("u")
  quantite      Decimal  @default(0) @db.Decimal(12, 3)
  prixUnitaireFcfa Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  operations  Operation[]

  @@unique([travailleurId, nom])
  @@index([travailleurId])
  @@map("articles_stock")
}

/// Tontine suivie par le travailleur.
model Tontine {
  id              String   @id @default(uuid())
  travailleurId   String
  nom             String
  cotisationFcfa  Int
  /// quotidien | hebdo | mensuel
  frequence       String   @default("mensuel")
  membres         Int      @default(1)
  note            String?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  travailleur Travailleur         @relation(fields: [travailleurId], references: [id], onDelete: Cascade)
  cotisations TontineCotisation[]

  @@index([travailleurId, actif])
  @@map("tontines")
}

model TontineCotisation {
  id          String   @id @default(uuid())
  tontineId   String
  montantFcfa Int
  datePaiement DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  tontine Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)

  @@index([tontineId, datePaiement])
  @@map("tontine_cotisations")
}

/// Notifications in-app (décision crédit, créances, etc.).
model NotificationInApp {
  id            String   @id @default(uuid())
  travailleurId String
  type          String
  titre         String
  corps         String
  lu            Boolean  @default(false)
  meta          Json?
  createdAt     DateTime @default(now())

  travailleur Travailleur @relation(fields: [travailleurId], references: [id], onDelete: Cascade)

  @@index([travailleurId, lu, createdAt])
  @@map("notifications_in_app")
}

/// Dossier scoring terrain agent DigiCoop (hors ligne → sync).
model AgentDossier {
  id                    String    @id @default(uuid())
  /// Idempotence sync (= clientMutationId mobile).
  clientMutationId      String    @unique
  agentUserId           String
  clientNom             String
  clientTelephone       String?
  /// Saisie formulaire (AgentScoreInput).
  inputJson             Json
  score                 Int
  /// recommande | analyse_complementaire | a_reexaminer
  recommendation        String
  chargeRate            Float
  montantSoutenableFcfa Int
  echeanceEstimeeFcfa   Int
  revenuMensuelFcfa     Int
  montantDemandeFcfa    Int
  /// Top drivers figés [{key,label,delta}].
  driversJson           Json
  resultJson            Json
  note                  String?
  /// soumise | en_examen | validee | a_revoir
  statut                String    @default("soumise")
  motifDecision         String?
  decidedAt             DateTime?
  /// rembourse_ok | defaut | en_cours | null (non labellisé)
  outcome               String?
  outcomeAt             DateTime?
  outcomeNote           String?
  /// expert_scorecard | calibrated_scorecard | ml_assisted
  engine                String    @default("expert_scorecard")
  modelVersion          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  agent Travailleur @relation(fields: [agentUserId], references: [id], onDelete: Restrict)

  @@index([agentUserId, createdAt])
  @@index([statut])
  @@index([recommendation])
  @@index([outcome])
  @@map("agent_dossiers")
}
