{
  "name": "neoforma",
  "private": true,
  "version": "0.1.0",
  "description": "NeoForma — inclusion financière, secteur informel Burkina Faso",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@neoforma/web & npm run dev --workspace=@neoforma/api",
    "dev:web": "npm run dev --workspace=@neoforma/web",
    "dev:api": "npm run dev --workspace=@neoforma/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@neoforma/api && npm run test --workspace=@neoforma/neoscore",
    "db:generate": "npm run db:generate --workspace=@neoforma/api",
    "db:migrate": "npm run db:migrate --workspace=@neoforma/api",
    "db:deploy": "npm run db:deploy --workspace=@neoforma/api",
    "db:status": "npm run db:status --workspace=@neoforma/api",
    "db:push": "npm run db:push --workspace=@neoforma/api",
    "mobile:run": "cd apps/mobile && flutter run --dart-define=API_BASE=http://10.0.2.2:3001",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
